        <mxCell id="8B4ogf53-gBxYu3b0KtV-318" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=42;spacingRight=42;fillColor=#ffffff;strokeColor=#C95F30;strokeWidth=2;fontFamily=Helvetica;fontSize=20;lineHeight=1.35;" value="&lt;b&gt;SecurityController&lt;/b&gt;&lt;br&gt;&lt;br&gt;• afficher le formulaire de connexion&lt;br&gt;&lt;div&gt;&lt;br&gt;• enregistrer la connexion&lt;/div&gt;&lt;div&gt;(messages d&#39;erreur si nécessaires)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;• se connecter au compte utilisateur existant&lt;br&gt;&lt;div&gt;• enregistrer la déconnexion et rediriger&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;vers AccueilController&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
