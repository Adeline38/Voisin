{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <form method="post" action="{{ path('app_connexion') }}">
        {% if error %}
            {# AVANT : #}
            {# <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div> #}

            {# APRÈS (Version simplifiée et francisée sans filtres complexes) : #}
            <div class="_alert _alert-danger" style="{# color: red; font-weight: bold; margin-bottom: 15px; #}">
                Le pseudo, l'email ou le mot de passe est incorrect.
            </div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                Vous êtes connecté en tant que <span style="text-transform: capitalize;">{{ app.user.userIdentifier }}</span>, <a href="{{ logout_path() }}">Déconnexion</a>
            </div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">Connexion</h1>
        {# <label for="username">Email</label>
        <input 
            type="email" 
            value="{{ last_username }}" 
            name="_username" 
            id="username" 
            class="form-control" 
            autocomplete="email" 
            required 
            autofocus
        > #}

        <label for="identifiant">Pseudo ou Adresse Email</label>
        <input
            type="text"
            value="{{ last_username }}"
            name="_username"
            id="identifiant"
            autocomplete="username"
            required 
            autofocus 
            placeholder="Entrez votre pseudo ou email"
        >

        <label for="password">Mot de passe</label>
        <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>
        #}

        <button class="btn btn-lg btn-primary" type="submit">Se connecter</button>  
    </form>      

    <p>Vous n’avez pas encore de compte ? <a href="{{ path('app_inscription') }}">S’inscrire</a></p>
{% endblock %}
