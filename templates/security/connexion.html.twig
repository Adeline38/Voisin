{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <form method="post" action="{{ path('app_connexion') }}">
        {% if error %}
            <div class="_alert _alert-danger" style="{# color: red; font-weight: bold; margin-bottom: 15px; #}">
                Le pseudo, l'email ou le mot de passe est incorrect.
            </div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                Vous êtes connecté en tant que <span style="text-transform: capitalize;">{{ app.user.userIdentifier }}</span>, <a href="{{ logout_path() }}">Déconnexion</a>
            </div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">Connexion</h1>
        <label for="identifiant">Pseudo ou adresse de courriel</label>
        <input
            type="text"
            value="{{ last_username }}"
            name="_username"
            id="identifiant"
            autocomplete="username"
            required 
            autofocus 
            placeholder="Saisissez votre pseudo ou votre adresse de courriel"
        >

        <label for="password">Mot de passe</label>
        <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <button class="btn btn-lg btn-primary" type="submit">Se connecter</button>  
    </form>      

    <p>Vous n’avez pas encore de compte ? <a href="{{ path('app_inscription') }}">S’inscrire</a></p>
{% endblock %}
