{% extends 'base.html.twig' %}

{% block title %}Publication{% endblock %}

{% block body %}
    <h1>Publication</h1>

    <table class="table">
        <tbody>
            {# <tr>
                <th>Id</th>
                <td>{{ publication.id }}</td>
            </tr> #}
            <tr>
                <th>Contenu</th>
                <td>{{ publication.contenu }}</td>
            </tr>
            <tr>
                <th>Photo</th>
                <td>
                    {# AFFICHAGE DE LA PHOTO AVEC UNE CONDITION TRÈS SIMPLE #}
                    {% if publication.photo %}
                        <img src="{{ asset('uploads/' ~ publication.photo) }}" alt="Photo de la publication" style="max-width: 300px; max-height: 300px;display: block;">
                    {% else %}
                        <span style="color: #888; font-style: italic;">Aucune image partagée pour ce message</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>Visibilite</th>
                <td>{{ publication.visibilite }}</td>
            </tr>
            <tr>
                <th>Date_creation</th>
                <td>{{ publication.dateCreation ? publication.dateCreation|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Date_modification</th>
                <td>{{ publication.dateModification ? publication.dateModification|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <br>
    <a href="{{ path('app_publication_index') }}">Retour à la liste</a> | 
    <a href="{{ path('app_publication_edit', {'id': publication.id}) }}">Modifier cette publication</a>

    <hr>
    {{ include('publication/_delete_form.html.twig') }}
{% endblock %}
