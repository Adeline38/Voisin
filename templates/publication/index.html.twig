{% extends 'base.html.twig' %}

{% block title %}Publication index{% endblock %}

{% block body %}
    <h1>Publication index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Contenu</th>
                <th>Photo</th>
                <th>Visibilite</th>
                <th>Date_creation</th>
                <th>Date_modification</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for publication in publications %}
            <tr>
                <td>{{ publication.id }}</td>
                <td>{{ publication.contenu }}</td>
                {# Symfony a généré une ligne brute <td>{{ publication.photo }}</td> qui affiche uniquement du texte si le champ est rempli, ou rien s'il est vide.
                <td>{{ publication.photo }}</td>#}
                <td>
                    {% if publication.photo %}
                        <img src="{{ asset('uploads/' ~ publication.photo) }}" alt="Photo de la publication" style="max-width: 100px; max-height: 100px; border-radius: 4px; object-fit: cover;">
                    {% else %}
                        <span style="font-style: italic;">Pas de photo</span>
                    {% endif %}
                </td>
                <td>{{ publication.visibilite }}</td>
                <td>{{ publication.dateCreation ? publication.dateCreation|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ publication.dateModification ? publication.dateModification|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_publication_show', {'id': publication.id}) }}">show</a>
                    <a href="{{ path('app_publication_edit', {'id': publication.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_publication_new') }}">Create new</a>
{% endblock %}
