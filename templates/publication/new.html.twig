{# templates/publication/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Nouvelle publication{% endblock %}

{% block body %}
    <div>
        <h1 style="margin-top: 0; color: #333;">Modifier votre message</h1>

        {# Si une photo existe déjà, on l'affiche en aperçu #}
        {% if publication.photo %}
            <div>
                <p>Image actuellement en ligne :</p>
                <img src="{{ asset('uploads/' ~ publication.photo) }}" alt="Aperçu" style="max-width: 150px; border-radius: 4px; display: block;">
            </div>
        {% endif %}

        {# OUVERTURE DU FORMULAIRE AVEC AUTORISATION DE SÉCURITÉ DE FICHIERS #}
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
            
            <div style="margin-bottom: 15px;">
                {{ form_row(form) }}
            </div>

            <button class="btn">
                Enregistrer les modifications
            </button>

        {{ form_end(form) }}

        <a href="{{ path('app_publication_index') }}">
            Retourner à la liste
        </a>
    </div>
{% endblock %}
